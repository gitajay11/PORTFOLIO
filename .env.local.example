# Copy this file to .env.local (not .env.local.example — that copy step
# matters, this template file is never read by the app) and add your key
# to enable the live AI assistant, powered by Groq.
#
# Get a key at https://console.groq.com/keys
#
# Without it the chat widget still works, answering from lib/chatKnowledge.ts.
# .env.local is gitignored — never commit a real key.
GROQ_API_KEY=gsk_...
